{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuan.local/schemas/project-install.schema.json",
  "title": "Yuan 项目安装记录",
  "type": "object",
  "required": ["schema_version", "framework_version", "runtime", "protocol_digest", "bootstrap_digest", "adapter_digest", "digest"],
  "properties": {
    "schema_version": {"enum": ["yuan.project-install/v1", "yuan.project-install/v2", "yuan.project-install/v3"]},
    "framework_version": {"type": "string"},
    "runtime": {
      "type": "object",
      "required": ["path", "digest", "bytes"],
      "properties": {
        "path": {"const": ".yuan/bin/yuan.pyz"},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "protocol_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bootstrap_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "adapter_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "capability_profile": {
      "type": "object",
      "required": ["id", "version", "manifest_digest", "files"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "files": {"type": "array", "minItems": 1, "items": {"type": "object"}}
      },
      "additionalProperties": false
    },
    "release": {"type": "object"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "yuan.project-install/v2"}}},
      "then": {"required": ["release"]}
    },
    {
      "if": {"properties": {"schema_version": {"const": "yuan.project-install/v3"}}},
      "then": {"required": ["release", "capability_profile"]}
    }
  ],
  "additionalProperties": false
}
