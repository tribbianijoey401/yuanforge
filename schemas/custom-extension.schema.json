{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuan.local/schemas/custom-extension.schema.json",
  "title": "Yuan Custom Extension Descriptor",
  "type": "object",
  "required": ["schema_version", "extension_id", "description", "rules", "agents", "skills", "digest"],
  "properties": {
    "schema_version": {"const": "yuan.custom-extension/v1"},
    "extension_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "description": {"type": "string", "minLength": 1},
    "rules": {"$ref": "#/$defs/catalog"},
    "agents": {"$ref": "#/$defs/catalog"},
    "skills": {"$ref": "#/$defs/catalog"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "catalog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "description", "use_when", "digest"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "path": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "use_when": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
