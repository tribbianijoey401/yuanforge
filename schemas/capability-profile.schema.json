{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuan.local/schemas/capability-profile.schema.json",
  "title": "Yuan Installed Capability Profile",
  "type": "object",
  "required": ["schema_version", "profile_id", "profile_version", "description", "boundary", "required_rules", "agents", "skills", "workflow", "files", "custom_root", "digest"],
  "properties": {
    "schema_version": {"const": "yuan.capability-profile/v2"},
    "profile_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "profile_version": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "boundary": {"const": "advisory-and-evidence-only"},
    "required_rules": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "agents": {"$ref": "#/$defs/catalog"},
    "skills": {"$ref": "#/$defs/catalog"},
    "workflow": {"$ref": "#/$defs/workflow"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "digest", "bytes", "kind"],
        "properties": {
          "path": {"type": "string"},
          "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 1},
          "kind": {"enum": ["profile", "rules", "agents", "skills"]}
        },
        "additionalProperties": false
      }
    },
    "custom_root": {"const": ".yuan/extensions/custom"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "route": {
      "type": "object",
      "required": ["agents", "skills"],
      "properties": {
        "agents": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "skills": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "required": ["schema_version", "base", "risk_routes", "signal_routes", "agent_skill_routes", "artifact_review_agents"],
      "properties": {
        "schema_version": {"const": "yuan.workflow/v1"},
        "base": {"$ref": "#/$defs/route"},
        "risk_routes": {
          "type": "object",
          "required": ["R0", "R1", "R2"],
          "properties": {"R0": {"$ref": "#/$defs/route"}, "R1": {"$ref": "#/$defs/route"}, "R2": {"$ref": "#/$defs/route"}},
          "additionalProperties": false
        },
        "signal_routes": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/route"}},
        "agent_skill_routes": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}},
        "artifact_review_agents": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "catalog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path", "description", "use_when"],
        "properties": {
          "id": {"type": "string"},
          "path": {"type": "string"},
          "description": {"type": "string"},
          "use_when": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
