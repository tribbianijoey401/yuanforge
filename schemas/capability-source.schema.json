{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuan.local/schemas/capability-source.schema.json",
  "title": "Yuan Bundled Capability Profile Source",
  "type": "object",
  "required": ["schema_version", "profile_id", "profile_version", "description", "required_rules", "agents", "skills"],
  "properties": {
    "schema_version": {"const": "yuan.capability-source/v1"},
    "profile_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "profile_version": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "required_rules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "agents": {"$ref": "#/$defs/catalog"},
    "skills": {"$ref": "#/$defs/catalog"}
  },
  "$defs": {
    "catalog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path", "description", "use_when"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "path": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "use_when": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
