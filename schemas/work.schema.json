{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuan.local/schemas/work.schema.json",
  "title": "Yuan Work Contract 记录",
  "type": "object",
  "required": ["schema_version", "work_id", "revision", "goal", "profile", "protocol", "harness", "intake", "routing", "confirmation", "artifact", "acceptance_criteria", "safety_invariants", "grants", "budgets", "predecessor", "created_at", "digest"],
  "properties": {
    "schema_version": {"const": "yuan.work/v2"},
    "work_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "goal": {"type": "string", "minLength": 1},
    "profile": {"enum": ["GUIDED", "AUDITED", "ENFORCED"]},
    "protocol": {"$ref": "#/$defs/binding"},
    "harness": {"$ref": "#/$defs/binding"},
    "intake": {"type": "object"},
    "routing": {"type": "object"},
    "confirmation": {"type": "object"},
    "artifact": {"type": "object"},
    "acceptance_criteria": {"type": "array", "minItems": 1},
    "safety_invariants": {"type": "array"},
    "grants": {"type": "array"},
    "budgets": {"type": "object"},
    "predecessor": {"type": ["object", "null"]},
    "created_at": {"type": "string", "minLength": 1},
    "digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binding": {
      "type": "object",
      "required": ["id", "revision", "digest"],
      "properties": {"id": {"type": "string"}, "revision": {"type": "string"}, "digest": {"$ref": "#/$defs/sha256"}},
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
