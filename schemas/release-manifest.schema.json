{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuan.local/schemas/release-manifest.schema.json",
  "title": "Yuan 发行清单",
  "type": "object",
  "required": ["schema_version", "version", "format", "artifact", "entrypoint", "sources", "digest"],
  "properties": {
    "schema_version": {"const": "yuan.release-manifest/v1"},
    "version": {"type": "string"},
    "format": {"const": "deterministic-zipapp-stored/v1"},
    "artifact": {"type": "object"},
    "entrypoint": {"type": "object"},
    "sources": {"type": "array", "minItems": 1},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
