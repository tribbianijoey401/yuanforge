{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuan.local/schemas/memory.schema.json",
  "title": "Yuan Long-term Memory Record v2",
  "type": "object",
  "required": ["schema_version", "memory_id", "revision", "kind", "title", "summary", "details", "status", "confidence", "tags", "relations", "bindings", "data", "source", "supersedes", "created_at", "digest"],
  "properties": {
    "schema_version": {"const": "yuan.memory/v2"},
    "memory_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "kind": {"enum": ["project", "feature", "module", "architecture", "convention", "decision", "pitfall", "incident", "checkpoint", "handoff"]},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "details": {"type": "string", "minLength": 1},
    "status": {"enum": ["active", "resolved", "superseded", "deprecated"]},
    "confidence": {"enum": ["verified", "decided", "observed", "hypothesis", "stale", "superseded", "deprecated"]},
    "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "relations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "bindings": {"type": "array", "items": {"type": "object"}},
    "data": {"type": "object"},
    "source": {
      "type": "object",
      "required": ["work_id", "work_revision", "work_digest", "evidence_ids", "attempt_ids", "artifact_digest", "ledger_head", "git_commit"],
      "additionalProperties": false
    },
    "supersedes": {"type": ["string", "null"]},
    "created_at": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
