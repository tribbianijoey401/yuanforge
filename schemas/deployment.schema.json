{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuan.local/schemas/deployment.schema.json",
  "title": "Yuan 部署来源与证明记录",
  "type": "object",
  "required": ["schema_version", "digest"],
  "properties": {
    "schema_version": {
      "enum": [
        "yuan.release-source/v1",
        "yuan.deployment-proof/v1"
      ]
    },
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
