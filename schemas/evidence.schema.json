{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuan.local/schemas/evidence.schema.json",
  "title": "Yuan Evidence 记录",
  "type": "object",
  "required": ["schema_version", "evidence_id", "work", "attempt_id", "criterion_id", "artifact", "environment", "harness", "verifier", "status", "assertions", "receipt", "independence", "created_at", "digest"],
  "properties": {
    "schema_version": {"const": "yuan.evidence/v1"},
    "evidence_id": {"type": "string", "minLength": 1},
    "work": {"type": "object"},
    "attempt_id": {"type": "string", "minLength": 1},
    "criterion_id": {"type": "string", "minLength": 1},
    "artifact": {"type": "object"},
    "environment": {"type": "object"},
    "harness": {"type": "object"},
    "verifier": {"type": "object"},
    "status": {"enum": ["PASS", "FAIL"]},
    "assertions": {"type": "array", "minItems": 1},
    "receipt": {"type": "object"},
    "independence": {"enum": ["independent", "previous-root", "external"]},
    "created_at": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
