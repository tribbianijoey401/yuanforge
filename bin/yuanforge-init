#!/usr/bin/env python3
"""Install only Yuan Core, adapters, and explicitly selected extensions."""

from __future__ import annotations

import argparse
import os
import pathlib
import re
import shutil
import sys
import tempfile


SOURCE_ROOT = pathlib.Path(__file__).resolve().parents[1]
VERSION_PATH = pathlib.PurePosixPath(".yuan/VERSION")
CORE_INPUTS = (
    pathlib.PurePosixPath("AGENTS.md"),
    VERSION_PATH,
)
CORE_TREES = (
    pathlib.PurePosixPath(".yuan/core"),
    pathlib.PurePosixPath(".yuan/adapters"),
)
EXTENSION_NAME = re.compile(r"^[a-z0-9][a-z0-9-]*$")


class InstallError(RuntimeError):
    """Unsafe or ambiguous initializer operation."""


def version() -> str:
    try:
        value = (SOURCE_ROOT / VERSION_PATH).read_text(encoding="utf-8").strip()
    except (OSError, UnicodeError) as error:
        raise InstallError(".yuan/VERSION is missing or unreadable") from error
    if not re.fullmatch(r"\d+\.\d+\.\d+", value):
        raise InstallError(".yuan/VERSION is not a semantic version")
    return value


def source_files(extensions: list[str]) -> list[pathlib.PurePosixPath]:
    files = list(CORE_INPUTS)
    for tree in CORE_TREES:
        source = SOURCE_ROOT / tree
        if not source.is_dir():
            raise InstallError(f"required distribution tree is missing: {tree}")
        files.extend(
            pathlib.PurePosixPath(path.relative_to(SOURCE_ROOT).as_posix())
            for path in sorted(source.rglob("*"))
            if path.is_file()
        )
    for name in extensions:
        if not EXTENSION_NAME.fullmatch(name):
            raise InstallError(f"invalid extension name: {name}")
        relative = pathlib.PurePosixPath(f".yuan/extensions/{name}.md")
        if not (SOURCE_ROOT / relative).is_file():
            raise InstallError(f"unknown extension: {name}")
        files.append(relative)
    return sorted(set(files), key=str)


def atomic_copy(source: pathlib.Path, destination: pathlib.Path) -> None:
    destination.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=f".{destination.name}.", dir=destination.parent
    )
    os.close(descriptor)
    temporary = pathlib.Path(temporary_name)
    try:
        shutil.copyfile(source, temporary)
        os.replace(temporary, destination)
    finally:
        if temporary.exists():
            temporary.unlink()


def install(
    target: pathlib.Path,
    *,
    extensions: list[str],
    update: bool,
    dry_run: bool,
) -> dict[str, int | str]:
    release = version()
    plan = source_files(extensions)
    target = target.absolute()
    blocked: list[str] = []
    for relative in plan:
        source = SOURCE_ROOT / relative
        destination = target / relative
        if destination.exists() and (
            not destination.is_file() or destination.read_bytes() != source.read_bytes()
        ):
            blocked.append(relative.as_posix())
    if blocked and not update:
        raise InstallError(
            "existing files differ; rerun with --update: " + ", ".join(blocked)
        )
    changed = 0
    unchanged = 0
    for relative in plan:
        source = SOURCE_ROOT / relative
        destination = target / relative
        if destination.is_file() and destination.read_bytes() == source.read_bytes():
            unchanged += 1
            continue
        changed += 1
        if not dry_run:
            atomic_copy(source, destination)
    return {
        "version": release,
        "files": len(plan),
        "changed": changed,
        "unchanged": unchanged,
    }


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description="Install the minimal Yuan Core distribution."
    )
    parser.add_argument("target", type=pathlib.Path)
    parser.add_argument(
        "--extension",
        action="append",
        default=[],
        help="copy one named extension (repeatable)",
    )
    parser.add_argument(
        "--update",
        action="store_true",
        help="CAS-replace differing distribution files",
    )
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args(argv)
    try:
        result = install(
            args.target,
            extensions=args.extension,
            update=args.update,
            dry_run=args.dry_run,
        )
    except (InstallError, OSError, UnicodeError) as error:
        print(f"BLOCKED {error}", file=sys.stderr)
        return 2
    print(
        f"Yuan Core {result['version']}: "
        f"{result['changed']} changed, {result['unchanged']} unchanged"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
