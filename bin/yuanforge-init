#!/usr/bin/env python3
"""Yuan vNext Project Installer。

用法：
  python -B bin/yuanforge-init <project> [--mode new|existing] [--force]
  python -B bin/yuanforge-init <project> --update [--force]
  python -B bin/yuanforge-init <project> --check

Update 由 Source Repository 外部执行，不依赖目标 Project 中的旧 Yuan Runtime、
Version 或 Integrity 状态。官方 Snapshot 会被最新内容整体替换；Project Document、
Override 与业务内容保持不变。
"""

from __future__ import annotations

import argparse
import importlib.util
import json
import os
import re
import shutil
import sys
from pathlib import Path


if hasattr(sys.stdout, "reconfigure"):
    sys.stdout.reconfigure(encoding="utf-8", errors="replace")
if hasattr(sys.stderr, "reconfigure"):
    sys.stderr.reconfigure(encoding="utf-8", errors="replace")


SCRIPT_DIR = Path(__file__).resolve().parent
SOURCE_ROOT = SCRIPT_DIR.parent
SOURCE_FRAMEWORK = SOURCE_ROOT / "framework"
SOURCE_INSIGHT = SOURCE_ROOT / "insight"

PROJECT_DOCUMENTS = (
    "PRODUCT.md",
    "ARCHITECTURE.md",
    "DECISIONS.md",
    "BACKLOG.md",
    "WORK.md",
    "STATUS.md",
    "MEMORY.md",
)

LEGACY_MANAGED_DIRS = (
    ".yuan/specs",
    ".yuan/docs",
    ".yuan/rules",
    ".yuan/platforms",
    ".yuan/bin",
    ".yuan/runtime",
    ".yuan/protocol.md",
    ".yuan/config.json",
)

REQUIRED_AGENT_HEADINGS = (
    "vNext Activation",
    "Skill Assignment",
    "Reference Boundary",
    "Output",
    "State Ownership",
)

UPDATE_SAFE_WORK_STATES = {"idle", "paused"}
INSIGHT_MANAGED_ENTRIES = {"tool", "yuan.py"}


def framework_version() -> str:
    version_file = SOURCE_FRAMEWORK / "VERSION"
    if not version_file.is_file():
        raise RuntimeError(f"Framework Version 缺失：{version_file}")
    return version_file.read_text(encoding="utf-8").strip()


def installed_framework_version(root: Path) -> str:
    """读取实际被检查的 Framework Version，不用 Source Version 冒充。"""
    version_file = root / "VERSION"
    try:
        return version_file.read_text(encoding="utf-8").strip()
    except (OSError, UnicodeError):
        return "unknown"


def read_update_work_state(target: Path) -> str | None:
    """只读取 STATUS frontmatter 的 work_state，不解释或迁移 Project 内容。"""
    status = target / "docs" / "STATUS.md"
    work = target / "docs" / "WORK.md"
    if not status.is_file():
        return "unknown" if work.is_file() else None
    try:
        text = status.read_text(encoding="utf-8")
    except (OSError, UnicodeError):
        return "unknown"
    if not text.startswith("---"):
        return "unknown"
    parts = text.split("---", 2)
    if len(parts) < 3:
        return "unknown"
    match = re.search(r"^work_state:\s*([^#\r\n]+)", parts[1], re.MULTILINE)
    if not match:
        return "unknown"
    value = match.group(1).strip().strip("'\"").lower()
    return value or "unknown"


def check_update_work_precondition(target: Path) -> tuple[bool, str | None]:
    """Update 只阻止已明确标记为 active 的 Work；不解释旧 Project 内容。"""
    state = read_update_work_state(target)
    if state != "active":
        return True, state
    return False, (
        f"UPDATE_BLOCKED_ACTIVE_WORK: 当前 work_state={state}。"
        "请先让 Yuan 完成并 Distill 当前 Work，或将其显式暂停为 "
        "work_state: paused。"
    )


def collect_preserved_project_paths(target: Path) -> list[tuple[str, str]]:
    """列出 Update 主动跳过的 Yuan-known Project-owned 路径。"""
    preserved: list[tuple[str, str]] = []
    for name in PROJECT_DOCUMENTS:
        path = target / "docs" / name
        if path.exists():
            preserved.append((f"docs/{name}", "Project Document: project-owned state and memory"))

    overrides = target / ".yuan" / "overrides"
    if overrides.exists():
        preserved.append((".yuan/overrides/", "Project Override: project-specific behavior"))

    insight_root = target / ".yuan" / "insight"
    if insight_root.is_dir():
        for item in sorted(insight_root.iterdir(), key=lambda value: value.name):
            if item.name in INSIGHT_MANAGED_ENTRIES or item.name.startswith(".tool-"):
                continue
            suffix = "/" if item.is_dir() else ""
            preserved.append(
                (
                    f".yuan/insight/{item.name}{suffix}",
                    "Insight Observation Data: project history",
                )
            )
    return preserved


def within(path: Path, parent: Path) -> bool:
    try:
        path.resolve().relative_to(parent.resolve())
        return True
    except ValueError:
        return False


def remove_scoped(path: Path, parent: Path) -> None:
    """只删除已验证位于 parent 内的精确目标。"""
    if not path.exists():
        return
    if path.resolve() == parent.resolve() or not within(path, parent):
        raise RuntimeError(f"拒绝删除越界路径：{path}")
    if path.is_dir():
        shutil.rmtree(path)
    else:
        path.unlink()


def copy_framework_snapshot(target: Path, dry_run: bool = False) -> None:
    """复制到同目录临时 Snapshot 后切换，不读取旧 Framework。"""
    yuan_dir = target / ".yuan"
    managed = yuan_dir / "framework"
    incoming = yuan_dir / f".framework-incoming-{os.getpid()}"
    retired = yuan_dir / f".framework-retired-{os.getpid()}"

    if dry_run:
        print(f"  replace {managed} <- {SOURCE_FRAMEWORK}")
        return

    yuan_dir.mkdir(parents=True, exist_ok=True)
    remove_scoped(incoming, yuan_dir)
    remove_scoped(retired, yuan_dir)
    shutil.copytree(SOURCE_FRAMEWORK, incoming)

    try:
        if managed.exists():
            managed.replace(retired)
        incoming.replace(managed)
    except BaseException:
        if not managed.exists() and retired.exists():
            retired.replace(managed)
        raise
    finally:
        remove_scoped(incoming, yuan_dir)
        remove_scoped(retired, yuan_dir)


def copy_insight_tool(target: Path, dry_run: bool = False) -> None:
    """更新官方 Insight Tool，保留 `.yuan/insight/` 中的 Trace/Summary/Session。"""
    insight_root = target / ".yuan" / "insight"
    managed = insight_root / "tool"
    incoming = insight_root / f".tool-incoming-{os.getpid()}"
    retired = insight_root / f".tool-retired-{os.getpid()}"
    if dry_run:
        print(f"  replace {managed} <- {SOURCE_INSIGHT}")
        return
    insight_root.mkdir(parents=True, exist_ok=True)
    remove_scoped(incoming, insight_root)
    remove_scoped(retired, insight_root)
    shutil.copytree(
        SOURCE_INSIGHT,
        incoming,
        ignore=shutil.ignore_patterns("__pycache__", "*.pyc", "*.pyo", "build", "dist", "*.egg-info"),
    )
    try:
        if managed.exists():
            managed.replace(retired)
        incoming.replace(managed)
    except BaseException:
        if not managed.exists() and retired.exists():
            retired.replace(managed)
        raise
    finally:
        remove_scoped(incoming, insight_root)
        remove_scoped(retired, insight_root)


def write_insight_launcher(target: Path, dry_run: bool = False) -> None:
    destination = target / ".yuan" / "insight" / "yuan.py"
    if dry_run:
        print(f"  write {destination}")
        return
    destination.parent.mkdir(parents=True, exist_ok=True)
    destination.write_text(
        "from pathlib import Path\n"
        "import sys\n\n"
        "tool = Path(__file__).resolve().parent / 'tool'\n"
        "sys.path.insert(0, str(tool))\n"
        "from yuan_insight.cli import yuan_main\n\n"
        "if __name__ == '__main__':\n"
        "    raise SystemExit(yuan_main())\n",
        encoding="utf-8",
    )


def migrate_legacy_custom_skills(target: Path, dry_run: bool = False) -> list[str]:
    """将 v3 的 user-* Skill 保留为 vNext Project Override。"""
    legacy = target / ".yuan" / "skills"
    override = target / ".yuan" / "overrides" / "skills"
    migrated: list[str] = []
    if not legacy.is_dir():
        return migrated

    for item in sorted(legacy.glob("user-*")):
        destination = override / item.name
        migrated.append(str(item.relative_to(target)))
        if dry_run:
            continue
        override.mkdir(parents=True, exist_ok=True)
        if item.is_dir():
            shutil.copytree(item, destination, dirs_exist_ok=True)
        else:
            shutil.copy2(item, destination)
    return migrated


def cleanup_legacy_managed_layout(target: Path, dry_run: bool = False) -> list[str]:
    removed: list[str] = []
    for relative in LEGACY_MANAGED_DIRS:
        path = target / relative
        if path.exists():
            removed.append(relative)
            if not dry_run:
                remove_scoped(path, target / ".yuan")

    legacy_skills = target / ".yuan" / "skills"
    if legacy_skills.exists():
        removed.append(".yuan/skills")
        if not dry_run:
            remove_scoped(legacy_skills, target / ".yuan")
    return removed


def write_project_adapter(target: Path, dry_run: bool = False) -> None:
    source = SOURCE_ROOT / "AGENTS.md"
    destination = target / "AGENTS.md"
    if dry_run:
        print(f"  write {destination}")
        return
    shutil.copy2(source, destination)


def ensure_project_documents(target: Path, dry_run: bool = False) -> list[str]:
    """只补缺，不覆盖现有 Project Memory。"""
    created: list[str] = []
    template_root = SOURCE_FRAMEWORK / "templates" / "project"
    docs_root = target / "docs"
    for name in PROJECT_DOCUMENTS:
        destination = docs_root / name
        if destination.exists():
            continue
        created.append(f"docs/{name}")
        if not dry_run:
            destination.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(template_root / name, destination)
    return created


def ensure_override_readme(target: Path, dry_run: bool = False) -> bool:
    destination = target / ".yuan" / "overrides" / "README.md"
    if destination.exists():
        return False
    if not dry_run:
        destination.parent.mkdir(parents=True, exist_ok=True)
        destination.write_text(
            "# Project Overrides\n\n"
            "使用与 `.yuan/framework/` 相同的相对路径覆盖单个官方资产。"
            "Update 永不覆盖本目录。只有确有 Project-specific 差异时才创建 Override。\n",
            encoding="utf-8",
        )
    return True


def write_install_record(target: Path, dry_run: bool = False) -> None:
    record = {
        "framework": "yuan-vnext",
        "version": framework_version(),
        "layout": ".yuan/framework",
        "override": ".yuan/overrides",
        "insight_tool": ".yuan/insight/tool",
        "insight_data": ".yuan/insight",
        "project_documents": [f"docs/{name}" for name in PROJECT_DOCUMENTS],
    }
    if dry_run:
        print(f"  write {target / '.yuan' / 'install.json'}")
        return
    destination = target / ".yuan" / "install.json"
    destination.parent.mkdir(parents=True, exist_ok=True)
    destination.write_text(
        json.dumps(record, ensure_ascii=False, indent=2) + "\n",
        encoding="utf-8",
    )
    (target / ".yuan" / "VERSION").write_text(
        framework_version() + "\n", encoding="utf-8"
    )


def merge_gitignore(target: Path, dry_run: bool = False) -> list[str]:
    required = ("__pycache__/", "*.py[cod]", ".yuan/.framework-incoming-*", ".yuan/.framework-retired-*")
    destination = target / ".gitignore"
    current = destination.read_text(encoding="utf-8") if destination.exists() else ""
    additions = [item for item in required if item not in current.splitlines()]
    if additions and not dry_run:
        separator = "" if not current or current.endswith("\n") else "\n"
        block = "# Yuan Installer 临时文件\n" + "\n".join(additions) + "\n"
        destination.write_text(current + separator + block, encoding="utf-8")
    return additions


def iter_skill_files(root: Path) -> list[Path]:
    files = [path for path in (root / "skills").glob("*.md") if path.is_file()]
    files.extend((root / "skills").glob("*/SKILL.md"))
    return sorted(files)


def parse_frontmatter_lists(frontmatter: str) -> dict[str, list[str]]:
    """解析 YAML Frontmatter 的列表字段，同时支持内联 [a, b] 与展开 - item 两种形式。"""

    result: dict[str, list[str]] = {}
    current_field: str | None = None
    current_items: list[str] = []
    for line in frontmatter.splitlines():
        match = re.match(r"^(\w+):\s*(.*)$", line)
        if match:
            if current_field is not None:
                result[current_field] = current_items
            current_field, rest = match.group(1), match.group(2).strip()
            current_items = []
            if rest.startswith("[") and rest.endswith("]"):
                current_items = [item.strip() for item in rest[1:-1].split(",") if item.strip()]
        elif current_field is not None and re.match(r"^\s*-\s+\S", line):
            current_items.append(re.sub(r"^\s*-\s+", "", line).strip())
    if current_field is not None:
        result[current_field] = current_items
    return result


def validate_project_state(target: Path, framework_root: Path) -> list[str]:
    """复用 Framework State Guard；Installer 不维护第二套状态语义。"""
    # Installer 从 Yuan Source Repository 外部运行。执行 Source 自己的受信 Guard，
    # 仅把目标 Framework 作为数据读取；不得 import 被检查 Project 中的 Python。
    guard_path = SOURCE_FRAMEWORK / "tools" / "state_guard.py"
    if not guard_path.is_file():
        return [
            "STATE_CHECK_UNAVAILABLE: 缺少 framework/tools/state_guard.py；"
            "请先 update Framework"
        ]
    try:
        spec = importlib.util.spec_from_file_location(
            "yuan_installed_state_guard", guard_path
        )
        if spec is None or spec.loader is None:
            raise ImportError("无法创建 State Guard module spec")
        guard = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(guard)
        issues = guard.validate_project_state(target, framework_root)
    except (OSError, UnicodeError, ImportError, AttributeError) as exc:
        return [f"STATE_CHECK_UNAVAILABLE: {type(exc).__name__}: {exc}"]
    return [
        f"STATE_DIVERGENCE[{issue.code}]: {issue.field}={issue.actual!r}; "
        f"expected={issue.expected}; repair={issue.repair}"
        for issue in issues
    ]


def validate_framework(root: Path) -> tuple[list[str], list[str]]:
    errors: list[str] = []
    warnings: list[str] = []

    required = (
        "README.md",
        "VERSION",
        "policies/core.md",
        "policies/routing.md",
        "policies/documents.md",
        "policies/state-contract.md",
        "policies/review.md",
        "agents/conductor.md",
        "workflows/small-change.md",
        "workflows/complex-bug.md",
        "workflows/new-feature.md",
        "workflows/large-project.md",
        "templates/project/WORK.md",
        "templates/project/STATUS.md",
        "tools/state_guard.py",
    )
    for relative in required:
        if not (root / relative).is_file():
            errors.append(f"缺少 Framework Asset：{relative}")

    agents = sorted(
        path for path in (root / "agents").glob("*.md")
        if path.name != "contract-template.md"
    )
    if len(agents) < 13:
        errors.append(f"Agent Contract 数量不足：{len(agents)} < 13")
    for path in agents:
        text = path.read_text(encoding="utf-8")
        for heading in REQUIRED_AGENT_HEADINGS:
            if heading not in text:
                errors.append(f"{path.relative_to(root)} 缺少 {heading}")

        for line_number, line in enumerate(text.splitlines(), 1):
            if "references/" not in line.lower():
                continue
            if any(negative in line for negative in ("不直接", "不得直接", "不读取", "不加载")):
                continue
            if re.search(r"(?:读取|加载|参考|read|load).{0,20}`?references/", line, re.I):
                errors.append(
                    f"{path.relative_to(root)}:{line_number} Agent 越过 Skill 直接调用 References"
                )

    skills = iter_skill_files(root)
    if len(skills) < 17:
        errors.append(f"Skill 数量不足：{len(skills)} < 17")
    for path in skills:
        text = path.read_text(encoding="utf-8")
        if "vNext Reference Routing" not in text:
            errors.append(f"{path.relative_to(root)} 缺少 vNext Reference Routing")

    references = [
        path for path in (root / "references").rglob("*.md")
        if path.name != "README.md"
    ]
    if len(references) < 30:
        errors.append(f"Reference 内容数量异常：{len(references)} < 30")

    agent_ids = {path.stem for path in agents}
    workflows = sorted((root / "workflows").glob("*.md"))
    if len(workflows) < 4:
        errors.append(f"Primary Workflow 数量不足：{len(workflows)} < 4")
    for path in workflows:
        text = path.read_text(encoding="utf-8")
        if not text.startswith("---"):
            errors.append(f"{path.relative_to(root)} 缺少 YAML Frontmatter")
            continue
        body = text.split("---", 2)
        if len(body) < 3:
            errors.append(f"{path.relative_to(root)} Frontmatter 不完整")
            continue
        frontmatter = body[1]
        declared = parse_frontmatter_lists(frontmatter)
        if not declared.get("stages"):
            errors.append(f"{path.relative_to(root)} 未声明 stable stages")
        for field in ("required_agents", "optional_agents"):
            declared_ids = set(declared.get(field, []))
            unknown = sorted(declared_ids - agent_ids)
            if unknown:
                errors.append(
                    f"{path.relative_to(root)} 声明了不存在的 Agent：{', '.join(unknown)}"
                )
        for group in declared.get("required_agent_groups", []):
            members = {member for member in group.split("|") if member}
            if len(members) < 2:
                errors.append(
                    f"{path.relative_to(root)} required_agent_groups 至少需要两个 Agent"
                )
            unknown = sorted(members - agent_ids)
            if unknown:
                errors.append(
                    f"{path.relative_to(root)} required_agent_groups 声明了不存在的 Agent：{', '.join(unknown)}"
                )
        if "required_skills" in declared:
            errors.append(
                f"{path.relative_to(root)} Workflow 不得越级声明 required_skills；Skill 由 Agent Contract 选择"
            )

    framework_locator_pattern = re.compile(
        r"`framework://((?:agents|skills|references|policies|workflows|adapters|templates)/[^`]+)`"
    )
    skill_locator_pattern = re.compile(r"`skill://([^`]+)`")
    for path in root.rglob("*.md"):
        text = path.read_text(encoding="utf-8")
        for match in framework_locator_pattern.finditer(text):
            relative = match.group(1).split("#", 1)[0]
            if any(token in relative for token in ("*", "{", "}", "<", ">")):
                continue
            candidate = root / relative
            if not candidate.exists():
                errors.append(
                    f"{path.relative_to(root)} -> Dangling Locator：framework://{relative}"
                )
        for match in skill_locator_pattern.finditer(text):
            relative = match.group(1).split("#", 1)[0]
            if any(token in relative for token in ("*", "{", "}", "<", ">")):
                continue
            skill_root = path.parent
            candidate = skill_root / relative
            if not candidate.exists():
                errors.append(
                    f"{path.relative_to(root)} -> Dangling Locator：skill://{relative}"
                )

    return sorted(set(errors)), sorted(set(warnings))


def check_project(target: Path) -> int:
    errors: list[str] = []
    warnings: list[str] = []
    installed_framework = target / ".yuan" / "framework"
    source_framework = target / "framework"
    managed = installed_framework if installed_framework.is_dir() else source_framework

    if not target.is_dir():
        errors.append(f"Project 不存在：{target}")
    elif not managed.is_dir():
        errors.append("缺少 `.yuan/framework/`，请先运行 update")
    else:
        framework_errors, framework_warnings = validate_framework(managed)
        errors.extend(framework_errors)
        warnings.extend(framework_warnings)

    installed_insight = target / ".yuan" / "insight" / "tool" / "yuan_insight" / "cli.py"
    source_insight = target / "insight" / "yuan_insight" / "cli.py"
    if not installed_insight.is_file() and not source_insight.is_file():
        errors.append("缺少 Yuan Insight Tool")

    for name in PROJECT_DOCUMENTS:
        if (target / "docs" / name).is_file():
            continue
        message = f"缺少 Project Document：docs/{name}"
        if name in {"WORK.md", "STATUS.md"}:
            errors.append(message)
        else:
            warnings.append(message)
    if not (target / "AGENTS.md").is_file():
        errors.append("缺少 AGENTS.md")
    if target.is_dir() and managed.is_dir():
        warnings.extend(validate_project_state(target, managed))

    print("Yuan Check")
    for warning in warnings:
        print(f"  WARN  {warning}")
    for error in errors:
        print(f"  ERROR {error}")
    if errors:
        print(f"  FAIL  {len(errors)} error(s), {len(warnings)} warning(s)")
        return 1
    print(f"  PASS  {installed_framework_version(managed)} ({len(warnings)} warning(s))")
    return 0


def install_or_update(
    target: Path,
    mode: str,
    update: bool,
    dry_run: bool,
) -> int:
    if not SOURCE_FRAMEWORK.is_dir():
        print(f"ERROR Source Framework 缺失：{SOURCE_FRAMEWORK}", file=sys.stderr)
        return 1
    if not (SOURCE_INSIGHT / "yuan_insight" / "cli.py").is_file():
        print(f"ERROR Source Insight 缺失：{SOURCE_INSIGHT}", file=sys.stderr)
        return 1
    source_errors, _ = validate_framework(SOURCE_FRAMEWORK)
    if source_errors:
        print("ERROR Source Framework Contract Check 失败：", file=sys.stderr)
        for error in source_errors:
            print(f"  - {error}", file=sys.stderr)
        return 1

    if mode == "new" and target.exists() and any(target.iterdir()):
        print(f"ERROR new 模式要求目标不存在或为空：{target}", file=sys.stderr)
        return 1
    if (mode == "existing" or update) and not target.is_dir():
        print(f"ERROR existing/update 模式要求 Project 已存在：{target}", file=sys.stderr)
        return 1

    if update:
        allowed, message = check_update_work_precondition(target)
        if not allowed:
            print(f"ERROR {message}", file=sys.stderr)
            return 1

    preserved_paths = collect_preserved_project_paths(target) if update else []
    gitignore_existed = (target / ".gitignore").is_file()

    if not dry_run:
        target.mkdir(parents=True, exist_ok=True)

    migrated = migrate_legacy_custom_skills(target, dry_run)
    copy_framework_snapshot(target, dry_run)
    copy_insight_tool(target, dry_run)
    write_insight_launcher(target, dry_run)
    write_project_adapter(target, dry_run)
    removed = cleanup_legacy_managed_layout(target, dry_run)
    # Project Document 已存在时逐字节保留；缺失时只补官方空模板。
    # Update 不解释、不迁移现有内容，但必须修复不完整安装。
    created_docs = ensure_project_documents(target, dry_run)
    override_created = ensure_override_readme(target, dry_run)
    write_install_record(target, dry_run)
    gitignore_added = merge_gitignore(target, dry_run)

    action = "Update" if update else "Install"
    managed_action = "WOULD UPDATE" if dry_run else "UPDATED"
    print(f"Yuan {action} {framework_version()}")
    print(f"  Project：{target}")
    print(f"  {managed_action} AGENTS.md | Framework Adapter")
    print(f"  {managed_action} .yuan/framework/ | Official Snapshot")
    print(f"  {managed_action} .yuan/insight/tool/ | Official Insight Tool")
    print(f"  {managed_action} .yuan/insight/yuan.py | Project-local Launcher")
    print(f"  {managed_action} .yuan/install.json | Install Metadata")
    print(f"  {managed_action} .yuan/VERSION | Framework Version")
    for path, reason in preserved_paths:
        print(f"  PRESERVED {path} | {reason}")
    if migrated:
        label = "WOULD MIGRATE" if dry_run else "MIGRATED"
        print(f"  {label} Override：{len(migrated)}")
    if removed:
        label = "WOULD REMOVE" if dry_run else "REMOVED"
        print(f"  {label} Legacy Managed Directory：{len(removed)}")
    if created_docs:
        label = "WOULD CREATE" if dry_run else "CREATED"
        for path in created_docs:
            print(f"  {label} {path} | Missing required Project Document")
    if override_created:
        label = "WOULD CREATE" if dry_run else "CREATED"
        print(f"  {label} Override Guide：1")
    if gitignore_existed:
        label = "WOULD MERGE" if dry_run else "MERGED"
        print(f"  {label} .gitignore | 只补充 Yuan 必需规则；Project 规则原样保留")
    elif gitignore_added:
        label = "WOULD CREATE" if dry_run else "CREATED"
        print(f"  {label} .gitignore | {len(gitignore_added)} 条 Yuan 必需规则")
    if dry_run:
        print("  DRY RUN：未修改文件")
        return 0

    result = check_project(target)
    if result == 0:
        print()
        print("安装已完成。现在直接向 Agent 描述你的 Goal、Bug 或修改需求即可。")
        print("Yuan 会自动恢复 Project Context，并按需求选择 Workflow、Agent、Skill 与 References；")
        print("不需要在描述中指定 Phase、Agent 或 Skill。")
    return result


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Yuan vNext Project Installer")
    parser.add_argument("target", help="目标 Project Root")
    parser.add_argument("--mode", choices=("new", "existing"), default="new")
    parser.add_argument("--update", action="store_true", help="强制替换最新官方 Snapshot")
    parser.add_argument("--check", action="store_true", help="只执行 Contract 与安装检查")
    parser.add_argument("--dry-run", action="store_true", help="预览，不修改文件")
    parser.add_argument("--force", action="store_true", help="兼容参数；非交互执行")
    parser.add_argument("--sync", action="store_true", help="兼容旧命令，等同 --update")
    parser.add_argument("--clean", action="store_true", help="兼容参数；vNext Update 固定清理 Managed Snapshot")
    parser.add_argument("--name", help="兼容参数；Product Name 由 Mentor Loop 写入 PRODUCT.md")
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    target = Path(args.target).resolve()
    if args.check:
        return check_project(target)
    update = args.update or args.sync
    mode = "existing" if update else args.mode
    return install_or_update(target, mode, update, args.dry_run)


if __name__ == "__main__":
    raise SystemExit(main())
