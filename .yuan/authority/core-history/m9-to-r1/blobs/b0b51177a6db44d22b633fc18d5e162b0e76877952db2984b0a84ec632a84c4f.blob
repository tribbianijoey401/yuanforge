from __future__ import annotations

import copy
import json
import unittest
from datetime import datetime, timezone

from _load import CORE_ROOT, load_core_module


conformance = load_core_module("conformance")


def fixture(kind: str) -> dict:
    return json.loads(
        (CORE_ROOT / "fixtures" / "valid" / f"{kind}.json").read_text(
            encoding="utf-8"
        )
    )


def rebuild(attempts: list[dict], **overrides: object) -> dict:
    work = fixture("work-contract")
    evidence = fixture("evidence")
    kwargs = {
        "current_artifact_sha256": evidence["artifact_binding"]["sha256"],
        "environment_id": evidence["environment_binding"]["id"],
        "environment_fingerprint": evidence["environment_binding"]["fingerprint"],
        "trusted_now": datetime(2026, 7, 27, tzinfo=timezone.utc),
    }
    kwargs.update(overrides)
    return conformance.rebuild_run_memory(work, attempts, [], **kwargs)


def unknown_attempt() -> dict:
    attempt = fixture("attempt")
    attempt["action"].update(
        {
            "type": "file-write",
            "mutating": True,
            "side_effect_class": "filesystem",
            "authorization_grant_id": "GRANT-core-candidate",
        }
    )
    attempt["journal"] = [
        {
            "ordinal": ordinal,
            "state": state,
            "recorded_at": f"2026-07-27T00:0{ordinal}:00+00:00",
            "receipt_sha256": None,
        }
        for ordinal, state in enumerate(
            ("PREPARED", "EXECUTING", "UNKNOWN"), start=1
        )
    ]
    attempt["side_effect_state"] = "UNKNOWN"
    attempt["tool_receipt"] = None
    attempt["postcondition"] = None
    attempt["evidence_ids"] = []
    attempt["outcome"] = "UNKNOWN"
    return attempt


class ReplayPendingTests(unittest.TestCase):
    def test_continue_always_projects_an_authorized_legal_step(self) -> None:
        memory = rebuild([])
        self.assertEqual("CONTINUE", memory["last_result"])
        self.assertTrue(memory["legal_next_steps"])
        self.assertEqual(
            "GRANT-core-candidate",
            memory["legal_next_steps"][0]["authorization_grant_id"],
        )

    def test_ungranted_human_judgment_projects_wait_auth(self) -> None:
        work = fixture("work-contract")
        work["acceptance_criteria"][0]["id"] = "AC-TOMBSTONE"
        work["acceptance_criteria"][0]["type"] = "human-judgment"
        work["authorization"]["grants"] = []
        work["revision"]["sha256"] = conformance.canonical_digest(
            work, omitted_paths=(("revision", "sha256"),)
        )
        evidence = fixture("evidence")
        memory = conformance.rebuild_run_memory(
            work,
            [],
            [],
            current_artifact_sha256=evidence["artifact_binding"]["sha256"],
            environment_id=evidence["environment_binding"]["id"],
            environment_fingerprint=evidence["environment_binding"]["fingerprint"],
            trusted_now=datetime(2026, 7, 27, tzinfo=timezone.utc),
        )
        self.assertEqual("WAIT_AUTH", memory["last_result"])
        self.assertTrue(memory["legal_next_steps"][0]["high_impact"])

    def test_untrusted_pass_evidence_does_not_satisfy_next_step(self) -> None:
        work = fixture("work-contract")
        attempt = fixture("attempt")
        evidence = fixture("evidence")
        evidence["verifier_binding"]["sha256"] = "0" * 64
        evidence["immutable_digest"] = conformance.canonical_digest(
            evidence, omitted_paths=(("immutable_digest",),)
        )
        memory = conformance.rebuild_run_memory(
            work,
            [attempt],
            [evidence],
            current_artifact_sha256=evidence["artifact_binding"]["sha256"],
            environment_id=evidence["environment_binding"]["id"],
            environment_fingerprint=evidence["environment_binding"]["fingerprint"],
            trusted_now=datetime(2026, 7, 27, tzinfo=timezone.utc),
        )
        self.assertEqual("CONTINUE", memory["last_result"])
        self.assertEqual(
            work["acceptance_criteria"][0]["id"],
            memory["legal_next_steps"][0]["ac_id"],
        )
        self.assertEqual({}, memory["ac_evidence"])

    def test_blocked_rebuild_preserves_valid_unknown_pointer(self) -> None:
        attempt = unknown_attempt()
        memory = rebuild([attempt])
        self.assertEqual("BLOCKED", memory["last_result"])
        self.assertEqual(
            [{"attempt_id": attempt["attempt_id"], "state": "UNKNOWN"}],
            memory["pending_side_effects"],
        )
        self.assertIn("UNKNOWN_SIDE_EFFECT", memory["rebuild"]["errors"])

    def test_digest_uncertainty_downgrades_pending_phase_to_unknown(self) -> None:
        attempt = unknown_attempt()
        attempt["journal"] = attempt["journal"][:1]
        attempt["side_effect_state"] = "PREPARED"
        attempt["outcome"] = "PENDING"
        memory = rebuild([attempt], expected_attempts_digest="0" * 64)
        self.assertEqual(
            [{"attempt_id": attempt["attempt_id"], "state": "UNKNOWN"}],
            memory["pending_side_effects"],
        )
        self.assertIn("ATTEMPTS_DIGEST_MISMATCH", memory["rebuild"]["errors"])

    def test_committed_read_and_invalid_attempts_do_not_forge_pending(self) -> None:
        read = fixture("attempt")
        self.assertEqual([], rebuild([read])["pending_side_effects"])

        committed = unknown_attempt()
        committed["action"]["scope"] = "tmp/output"
        receipt = {
            "schema_version": "yuan.tool-receipt/v1",
            "kind": "file-write",
            "operation_id": "OP-committed",
            "status": "REPLACED",
            "path": "tmp/output",
            "before_sha256": "1" * 64,
            "after_sha256": "2" * 64,
        }
        receipt_digest = conformance.canonical_digest(receipt)
        committed["journal"] = [
            {
                "ordinal": ordinal,
                "state": state,
                "recorded_at": f"2026-07-27T00:1{ordinal}:00+00:00",
                "receipt_sha256": (
                    receipt_digest if state in {"OBSERVED", "COMMITTED"} else None
                ),
            }
            for ordinal, state in enumerate(
                ("PREPARED", "EXECUTING", "OBSERVED", "COMMITTED"), start=1
            )
        ]
        committed["side_effect_state"] = "COMMITTED"
        committed["tool_receipt"] = receipt
        committed["postcondition"] = {
            "scope": "tmp/output",
            "observed_sha256": "2" * 64,
            "satisfied": True,
        }
        committed["outcome"] = "SUCCEEDED"
        self.assertEqual([], rebuild([committed])["pending_side_effects"])

        invalid = copy.deepcopy(unknown_attempt())
        invalid["journal"][0]["ordinal"] = 2
        self.assertEqual([], rebuild([invalid])["pending_side_effects"])


if __name__ == "__main__":
    unittest.main()
