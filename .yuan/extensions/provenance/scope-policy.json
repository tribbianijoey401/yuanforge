{
  "schema_version": "yuan.provenance-scope-policy/v1",
  "include_roots": [
    "contracts",
    ".yuan/core/0.1",
    ".yuan/adapters",
    ".yuan/migration",
    ".yuan/specs",
    ".yuan/rules",
    ".yuan/docs",
    ".yuan/skills",
    ".yuan/platforms",
    "protocols",
    "templates",
    "docs/policies",
    "docs/knowledge",
    "references",
    "scripts"
  ],
  "include_files": [
    "AGENTS.md",
    "README.md",
    ".yuan/VERSION",
    "bin/yuanforge-init",
    "docs/ARCHITECTURE.md",
    "docs/CONVENTIONS.md",
    "docs/INDEX.md",
    "docs/SETUP.md",
    "docs/anti-patterns.md",
    "docs/glossary.md",
    "docs/object-model.yaml",
    "docs/pitfalls.md",
    "docs/ptg-critical.md",
    "docs/MVP专家团对标与YuanForge优化.md"
  ],
  "ignore_suffixes": [".pyc"],
  "ignore_segments": ["__pycache__"],
  "required_families": [
    "AGENTS.md",
    "README.md",
    "contracts/",
    ".yuan/core/0.1/",
    ".yuan/specs/",
    ".yuan/rules/",
    ".yuan/docs/",
    ".yuan/skills/",
    ".yuan/platforms/",
    "protocols/",
    "templates/",
    "docs/policies/",
    "references/",
    "scripts/"
  ],
  "excluded_inventory": [
    {"path": "docs/archive/**", "reason": "historical workspace evidence, not active normative authority"},
    {"path": "docs/2026*/**", "reason": "Workspace runtime state and Evidence; Genesis/M3-M6 remain separate migration Gate inputs"},
    {"path": "docs/events/**", "reason": "runtime event journal"},
    {"path": "docs/PROGRESS.md", "reason": "legacy runtime projection"},
    {"path": "docs/workspace/**", "reason": "runtime backlog and roadmap"},
    {"path": "docs/decisions/**", "reason": "active project decision register, including protected user dirty content"},
    {"path": ".yuan-shadow/**", "reason": "shadow runtime projection"},
    {"path": ".yuan-run/**", "reason": "target runtime projection"},
    {"path": "tests/**", "reason": "executable validation plane, not legacy normative corpus"},
    {"path": ".yuan/extensions/**", "reason": "M7 generated target; excluded to prevent recursive provenance"},
    {"path": ".git/**", "reason": "repository internals"},
    {"path": "**/__pycache__/**", "reason": "generated cache"}
  ]
}
