def sync_framework_item(
    item: str,
    src_root: Path,
    dst_root: Path,
    dry_run: bool = False,
    clean_orphans: bool = False,
) -> dict:
    """同步一个框架项（文件或目录）。"""
    src = src_root / item
    dst = dst_root / item

    if src.is_dir():
        return sync_directory(src, dst, dry_run, clean_orphans)
    else:
        # 单文件
        if not dst.exists():
            if not dry_run:
                dst.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(src, dst)
            return {item: "added"}
        elif file_sha256(src) != file_sha256(dst):
            if not dry_run:
                shutil.copy2(src, dst)
            return {item: "updated"}
        else:
            return {item: "skipped"}


