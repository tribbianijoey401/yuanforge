if yaml_files:
    import yaml
    for f in yaml_files:
        path = REPO_ROOT / f
        try:
            with open(path) as fh:
                yaml.safe_load(fh)
        except yaml.YAMLError as e:
            print(f"[ERROR] YAML syntax error in {f}: {e}")
            sys.exit(1)

