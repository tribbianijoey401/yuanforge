@dataclass(frozen=True)
class CommandReceipt:
    schema_version: str
    kind: str
    operation_id: str
    status: str
    profile: str
    sandboxed: bool
    argv: tuple[str, ...]
    cwd: str
    started_at: str
    duration_seconds: float
    exit_code: int | None
    stdout: str
    stderr: str
    stdout_sha256: str
    stderr_sha256: str
    stdout_truncated: bool
    stderr_truncated: bool
