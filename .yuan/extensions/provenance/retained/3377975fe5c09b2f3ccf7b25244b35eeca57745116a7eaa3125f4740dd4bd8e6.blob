if contract_files:
    import re
    issues = []
    for cf in contract_files:
        cp = REPO_ROOT / cf
        ct = cp.read_text()
        # P-F: has ## 门禁定义
        if '## 门禁定义' not in ct:
            issues.append(f"  {cf}: missing ## 门禁定义")
        # M6: defensive directive references contract-conventions.md
        if '## 防御性指令' in ct and 'contract-conventions.md' not in ct:
            issues.append(f"  {cf}: ## 防御性指令 does not reference contract-conventions.md")
        # P-C: review roles must have 对抗式审查
        if 'Reviewer' in cf or cf in ('tester.md', 'quality-auditor.md'):
            if '## 对抗式审查' not in ct:
                issues.append(f"  {cf}: missing ## 对抗式审查")
    
    if issues:
        print("⚠️  Scorecard audit findings:")
        for iss in issues:
            print(iss)
        print("  (Non-blocking: <2.5 avg = tech debt tracked in TASK_BOARD)")
    else:
        print("  ✓ Scorecard audit: all modified contracts pass structural checks")

# ── All good ───────────────────────────────────────────────────────

