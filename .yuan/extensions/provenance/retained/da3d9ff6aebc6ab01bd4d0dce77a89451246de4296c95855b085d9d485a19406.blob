def canonical_digest(value: Any, *, omit: tuple[str, ...] = ()) -> str:
    if omit:
        value = json.loads(json.dumps(value, ensure_ascii=False))
        cursor = value
        for key in omit[:-1]:
            cursor = cursor[key]
        cursor.pop(omit[-1], None)
    return hashlib.sha256(canonical_json(value).rstrip(b"\n")).hexdigest()


